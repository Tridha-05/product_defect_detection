# Copy this file to ".env" (same folder) and edit if needed.
# For LOCAL use you can skip this completely - defaults work.

# Database. Default = SQLite file (no install needed).
# For deployment use a free PostgreSQL URL (Neon / Supabase), like:
# DATABASE_URL=postgresql://user:password@host/dbname
# DATABASE_URL=

# Where the trained model lives
# MODEL_PATH=saved_models/resnet50_defect.pth

# Only for deployment: a direct download link to the .pth file
# (backend downloads it on first start if the file is missing)
# MODEL_URL=

# Who may call the API (comma separated). * = everyone (OK for a college project)
ALLOWED_ORIGINS=*
